# SMART CAMPUS ENVIRONMENT CONFIGURATION
# Insert your Firebase project credentials here.
# If left empty, the application seamlessly activates the built-in Intelligent Demo/Local Storage fallback
# with zero breaking changes or runtime crashes.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Backend Computer Vision & ML API URL
VITE_BACKEND_API_URL=http://localhost:8000
VITE_BACKEND_WS_URL=ws://localhost:8000/ws/occupancy
